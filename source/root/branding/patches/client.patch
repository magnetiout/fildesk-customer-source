 int APIENTRY wWinMain(_In_ HINSTANCE instance, _In_opt_ HINSTANCE prev,
                       _In_ wchar_t *command_line, _In_ int show_command)
 {
-  HINSTANCE hInstance = LoadLibraryA("librustdesk.dll");
+  // Fil: do not resolve runtime/plugins from the download folder, CWD or PATH.
+  // This runs in the application as DLL search flags do not inherit from a launcher.
+  if (!SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_APPLICATION_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32) ||
+      !SetDllDirectoryW(L"")) {
+    MessageBoxW(nullptr, L"FilDesk g\u00fcvenli DLL aramas\u0131n\u0131 ba\u015flatamad\u0131.", L"FilDesk", MB_OK | MB_ICONERROR);
+    return EXIT_FAILURE;
+  }
+  HINSTANCE hInstance = LoadLibraryExW(L"librustdesk.dll", nullptr,
+      LOAD_LIBRARY_SEARCH_APPLICATION_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
   if (!hInstance)
   {
     std::cout << "Failed to load librustdesk.dll." << std::endl;
@@ -80,7 +90,7 @@ int APIENTRY wWinMain(_In_ HINSTANCE instance, _In_opt_ HINSTANCE prev,
         command_line_arguments.end());
   }
 
