diff --git a/tests/security_regression.rs b/tests/security_regression.rs
new file mode 100644
index 0000000..4e7fb1a
--- /dev/null
+++ b/tests/security_regression.rs
@@ -0,0 +1,44 @@
+//! Focused security upgrade regressions; synthetic data only.
+use hbb_common::{bytes::BytesMut, protobuf::Message, rendezvous_proto::RendezvousMessage};
+#[path = "../src/database.rs"]
+mod database;
+
+#[test]
+fn security_protobuf_rejects_deep_unknown_groups() {
+    // Unknown protobuf group nesting must error, not exhaust the process stack.
+    let mut input = vec![0x0b; 10_000];
+    input.extend(vec![0x0c; 10_000]);
+    assert!(RendezvousMessage::parse_from_bytes(&input).is_err());
+}
+
+#[test]
+fn security_bytes_reserve_rejects_capacity_overflow() {
+    let mut prefix = BytesMut::from(&b"hello world"[..]);
+    let mut suffix = prefix.split_off(5);
+    drop(prefix);
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        suffix.reserve(usize::MAX - 6);
+    }));
+    assert!(result.is_err());
+    assert_eq!(&suffix[..], b" world");
+}
+
+#[test]
+fn security_sqlite_identity_survives_reopen() {
+    let path = format!("test.security-{}.sqlite3", uuid::Uuid::new_v4());
+    let runtime = hbb_common::tokio::runtime::Builder::new_current_thread()
+        .enable_all().build().unwrap();
+    runtime.block_on(async {
+        let db = database::Database::new(&path).await.unwrap();
+        let guid = db.insert_peer("fil-security-test", &[1; 16], &[2; 32], "{}").await.unwrap();
+        let peer = db.get_peer("fil-security-test").await.unwrap().unwrap();
+        assert_eq!(peer.guid, guid);
+        assert_eq!(peer.pk, vec![2; 32]);
+        db.update_pk(&guid, "fil-security-test", &[3; 32], "{}").await.unwrap();
+        drop(db);
+        let reopened = database::Database::new(&path).await.unwrap();
+        let peer = reopened.get_peer("fil-security-test").await.unwrap().unwrap();
+        assert_eq!(peer.pk, vec![3; 32]);
+    });
+    std::fs::remove_file(path).unwrap();
+}
